SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave_publica
SUPABASE_DASHBOARD_SECRET=gere_um_segredo_aleatorio_forte
ADMIN_EMAILS=administrador@empresa.com.br
AUTH_SESSION_SECRET=gere_um_segredo_aleatorio_com_pelo_menos_32_caracteres
# Somente para desenvolvimento local sem login. Nunca habilite em produção.
AUTH_DEV_BYPASS=false

# Organização opcional da descrição por IA (somente no servidor).
# Desativada até configurar chave, modelo e limites de uso na hospedagem.
TRIAGE_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_TRIAGE_MODEL=
# Chatbot conversacional em /atendimento. Use um modelo compatível com Structured Outputs.
CHATBOT_AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_CHATBOT_MODEL=gemini-3.5-flash-lite
CHATBOT_N8N_WEBHOOK_URL=http://localhost:5678/webhook/wg-hidraulica-chatbot

# --- Projeto Integrado P2: somente stack local (ver docs/P2/README.md) ---
# Para a P2, use SUPABASE_URL=http://127.0.0.1:54321 e a chave Publishable de `pnpm exec supabase status`.
# As suítes P2 recusam qualquer URL que não seja de loopback.
P2_LOCAL_BASE_URL=http://localhost:3000
# Solicitação fictícia criada por supabase/seed.sql.
P2_LOCAL_REQUEST_ID=20000000-0000-4000-8000-000000000001
# Conta fictícia criada no Supabase Auth local e listada em ADMIN_EMAILS.
P2_LOCAL_ADMIN_EMAIL=administrador.p2@local.test
P2_LOCAL_ADMIN_PASSWORD=
# Conta fictícia local NÃO listada em ADMIN_EMAILS (CT-007).
P2_LOCAL_NONADMIN_EMAIL=p2.ct007.nao-admin@local.test
P2_LOCAL_NONADMIN_PASSWORD=
