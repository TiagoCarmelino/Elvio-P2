{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern tmp",
    "test": "node --test tests/auth.test.mjs tests/triage.test.mjs tests/commercial-status.test.mjs",
    "test:local": "node --env-file-if-exists=.env.local --test tests/local-flows.integration.test.mjs tests/p2-api.integration.test.mjs",
    "test:selenium": "node --env-file-if-exists=.env.local --test tests/p2-selenium.selenium.mjs",
    "test:postman": "node --env-file-if-exists=.env.local scripts/p2-postman-local.mjs",
    "test:nonfunctional": "node --env-file-if-exists=.env.local --test tests/p2-nonfunctional.test.mjs",
    "n8n:up": "docker compose --env-file infra/n8n/.env.example -f infra/n8n/compose.yaml up -d",
    "n8n:logs": "docker compose --env-file infra/n8n/.env.example -f infra/n8n/compose.yaml logs -f n8n",
    "n8n:stop": "docker compose --env-file infra/n8n/.env.example -f infra/n8n/compose.yaml stop n8n",
    "n8n:down": "docker compose --env-file infra/n8n/.env.example -f infra/n8n/compose.yaml down"
  },
  "dependencies": {
    "next": "16.2.6",
    "pdf-lib": "^1.17.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "newman": "^6.2.3",
    "react-server-dom-webpack": "19.2.6",
    "selenium-webdriver": "4.52.0",
    "supabase": "3.1.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
